# ---------------------------------------------------------------------------
# PayPal Sandbox (Developer Dashboard -> Apps & Credentials -> Sandbox)
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional. Leave empty and the app reuses or auto-creates the Sandbox webhook
# on startup, then keeps the returned ID in memory. If PayPal is live and no ID
# can be obtained, /api/webhooks/paypal rejects requests instead of accepting
# unverified events. Signature verification is skipped only in simulated mode.
PAYPAL_WEBHOOK_ID=

# Public URL registered with PayPal. Set this to your deployed API URL for real
# Sandbox deliveries. The fallback is the demo URL below.
PAYPAL_WEBHOOK_URL=https://paypulse-demo.example.com/api/webhooks/paypal

# true = hydrate every invoice already in the Sandbox account (can include
# clutter from earlier test runs); false = start from the seeded demo book.
MERGE_LIVE_INVOICES=false

# ---------------------------------------------------------------------------
# LLM tool calling (OpenAI-compatible: Ollama, OpenAI, Groq, Gemini proxy, ...)
#
# Local Ollama, $0 and offline:
#   ollama serve
#   ollama pull qwen3.5:2b
# qwen3.5:2b is a good CPU-friendly tool-calling model. Use qwen3.5:4b or
# qwen3.5:latest for higher quality if your machine has the RAM/GPU.
# Leave the key as "ollama"; the server ignores it.
#
# Free cloud alternative (replace the three values):
#   OPENAI_API_KEY=your_groq_or_gemini_openai_compatible_key
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
# ---------------------------------------------------------------------------
OPENAI_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3.5:2b
LLM_PROVIDER=ollama
LLM_TIMEOUT=60
LLM_AUTO_MODEL=true
# Qwen3.5 is a thinking model; "none" disables hidden reasoning for fast,
# non-empty customer-facing copy. Try "low" if you want more deliberation.
LLM_REASONING_EFFORT=none

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Strongly recommended shared secret for direct API access. When set, every
# /api/* route except /api/health and the PayPal webhook requires X-API-Key.
# This is not a user login system; put public deployments behind an auth proxy.
PAYPULSE_API_KEY=

# Reject oversized request bodies, including chunked requests. Default 64 KiB.
MAX_REQUEST_BYTES=65536
